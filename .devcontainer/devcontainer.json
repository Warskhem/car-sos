{
    "name": "Car SOS",
    "image": "mcr.microsoft.com/devcontainers/python:3.12",
    "forwardPorts": [5000],
    "portsAttributes": {
        "5000": {
            "label": "Car SOS App",
            "onAutoForward": "notify"
        }
    },
    "postCreateCommand": "pip install -r requirements.txt",
    "postStartCommand": "bash start.sh",
    "customizations": {
        "vscode": {
            "extensions": ["ms-python.python"]
        }
    }
}
